frank 11
─────────
1. Drag frank 11.app -> Applications (shortcut on the right).
2. Paste into Terminal:
cat > install.command <<'EOF' && chmod +x install.command && ./install.command
#!/usr/bin/env bash
set -euo pipefail
APP="/Applications/frank 11.app"
echo "frank 11 installer"
echo "==================="
if [[ ! -d "$APP" ]]; then
  echo ""
  echo "frank 11.app not found in /Applications."
  echo "Drag frank 11.app into /Applications and run this installer again."
  echo ""
  read -rp "Press Return to close..."
  exit 1
fi
echo ""
echo "Removing quarantine attributes..."
xattr -cr "$APP" || true
echo ""
echo "Applying ad-hoc signature..."
codesign --force --deep --sign - "$APP"
echo ""
echo "Verifying signature..."
codesign --verify --deep --strict --verbose=1 "$APP"
echo ""
echo "Checking Gatekeeper assessment..."
spctl --assess --type execute --verbose "$APP" || true
echo ""
echo "Installation complete."
echo "You can now open frank 11 from /Applications."
echo ""
read -rp "Press Return to close..."
EOF
Run the app from Applications.
